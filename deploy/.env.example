# Kopieer dit bestand naar ".env" in de hoofdmap van de bot (naast main_live_bot.py)
# en vul je eigen gegevens in. ".env" staat in .gitignore en wordt NOOIT geupload.

# --- MetaTrader 5 (van The5ers) ---
MT5_LOGIN=12345678
MT5_PASSWORD=jouw_wachtwoord
MT5_SERVER=5ersLtd-Server
# Pad naar de terminal. Laat leeg als MT5 standaard is geinstalleerd.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Optioneel: dagstop van de bot wijzigen (standaard 2.5). Gebruik liever
#     deploy\set_daily_limit.bat <procent>, dat past deze regel aan.
# CFG_DAILY_HALT_PCT=2.5

# --- Optioneel: handmatig de fase forceren: 1, 2 of funded
# CHALLENGE_STEP=1
